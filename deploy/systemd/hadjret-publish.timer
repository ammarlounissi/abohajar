[Unit]
Description=Check for due social posts every minute

[Timer]
# كل دقيقة عند الثانية 0؛ الخدمة تبحث عن المنشورات التي حان موعدها (approved وscheduled_at <= الآن) وتنشرها
OnCalendar=*-*-* *:*:00
# دقة 1 ثانية (الافتراضي دقيقة كاملة قد تؤخر التشغيل)
AccuracySec=1s
# بلا تعويض للتشغيلات الفائتة أثناء توقف الجهاز: كل تشغيل يفحص كل ما حان موعده على أي حال
Persistent=false

[Install]
WantedBy=timers.target
