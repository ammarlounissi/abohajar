DATABASE_URL=
VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_CATALOG_ID=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v19.0
ADMIN_API_KEY=
BASE_URL=https://api.hadjretbladi.com
ALLOWED_ORIGINS=https://hadjretbladi.com,https://www.hadjretbladi.com
IMAGE_BASE_URL=https://hadjretbladi.com
# مجلد الصور على القرص (خارج المشروع، تخدمه Nginx). يجب أن يكون موجوداً وقابلاً للكتابة.
MEDIA_ROOT=/srv/hajret/media/products
# اختياري: أين تُحفظ نسخة الصورة القديمة عند استبدالها (الافتراضي ./media_backup)
MEDIA_BACKUP_DIR=
PRODUCT_LINK_TEMPLATE=https://hadjretbladi.com/{SKU}/

# الاستيراد التلقائي من مجلد الصور (python -m scripts.import_from_media)
# ملف CSV بالأعمدة sku,title,price (يفضَّل أن يكون خارج MEDIA_ROOT)
PRODUCTS_CSV_PATH=
# رقم المصنع الافتراضي للمنتجات الجديدة (id من جدول factories)
DEFAULT_FACTORY_ID=

# أمر واتساب الإداري للاستيراد التلقائي. فارغ = معطّل.
# من أرسل هذه الكلمة (وحدها) إلى بوت المصنع يُنفَّذ الاستيراد ومزامنة ميتا فوراً بلا تأكيد.
# ولّدها بنفسك (12 حرفاً على الأقل):
#   python3 -c "import secrets; a='abcdefghjkmnpqrstuvwxyz23456789'; print('-'.join(''.join(secrets.choice(a) for _ in range(4)) for _ in range(4)))"
IMPORT_PASSWORD=
# اختياري: قيّد الأمر بأرقام محددة (دولية، مفصولة بفواصل)، مثل 213550000000
ADMIN_PHONE_NUMBERS=
# اختياري: قيّد الأمر في قنوات أخرى بصيغة channel:id مفصولة بفواصل، مثل telegram:123456789
ADMIN_CONTACTS=

# النشر التلقائي على فيسبوك وإنستغرام (python -m app.jobs.publish_due)
# بلا علامات اقتباس وفي سطر واحد. تنظيف أي قيمة: printf '%s' "$VALUE" | tr -cd 'A-Za-z0-9'
# META_ACCESS_TOKEN أعلاه هو رمز مستخدم النظام الدائم نفسه (يخدم الكتالوج والنشر).
# ملاحظة: القنوات تُسجَّل عبر /api/social-channels (جدول social_channels) والناشر لا يقرأ هذين المتغيرين.
# يقرؤهما الترحيل d3a8f1c5b7e9 وحده لتسجيلهما كقناتين مرة واحدة إن وُجدا، ثم يمكن حذفهما من .env.
META_PAGE_ID=
META_IG_USER_ID=
# رقم واتساب في منشورات المنتجات (app/services/post_templates.py)
POST_CONTACT_PHONE=0549194378
# السقف اليومي لكل قناة (صفحة/حساب) خلال 24 ساعة (حد إنستغرام حوالي 100 لكل حساب).
# PUBLISH_DAILY_LIMIT احتياطي لأي منصة بلا سقف خاص. PUBLISH_PER_RUN: أقصى منشورات في كل تشغيل للمؤقت (دقيقة).
PUBLISH_DAILY_LIMIT=50
PUBLISH_DAILY_LIMIT_INSTAGRAM=50
PUBLISH_DAILY_LIMIT_FACEBOOK=200
PUBLISH_PER_RUN=10
# بعد كم دقيقة يُعدّ publishing عالقاً
PUBLISH_STALE_MINUTES=30
