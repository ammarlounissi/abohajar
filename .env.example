BASE_URL=https://api.hadjretbladi.com
ALLOWED_ORIGINS=https://hadjretbladi.com,https://www.hadjretbladi.com,https://store.hadjretbladi.com
IMAGE_BASE_URL=https://hadjretbladi.com
# مجلد الصور على القرص (خارج المشروع، تخدمه Nginx). يجب أن يكون موجوداً وقابلاً للكتابة.
MEDIA_ROOT=/srv/hajret/media/products
# اختياري: أين تُحفظ نسخة الصورة القديمة عند استبدالها (الافتراضي ./media_backup)
MEDIA_BACKUP_DIR=
PRODUCT_LINK_TEMPLATE=https://store.hadjretbladi.com/{sku}

# الاستيراد التلقائي من مجلد الصور (python -m scripts.import_from_media)
# ملف CSV بالأعمدة sku,title,price (يفضَّل أن يكون خارج MEDIA_ROOT)
PRODUCTS_CSV_PATH=
# رقم المصنع الافتراضي للمنتجات الجديدة (id من جدول factories)
DEFAULT_FACTORY_ID=

# أمر واتساب الإداري للاستيراد التلقائي. فارغ = معطّل.
# من أرسل هذه الكلمة (وحدها) إلى بوت المصنع يُنفَّذ الاستيراد ومزامنة ميتا فوراً بلا تأكيد.
# ولّدها بنفسك (12 حرفاً على الأقل):
#   python3 -c "import secrets; a='abcdefghjkmnpqrstuvwxyz23456789'; print('-'.join(''.join(secrets.choice(a) for _ in range(4)) for _ in range(4)))"
IMPORT_PASSWORD=
# اختياري: قيّد الأمر بأرقام محددة (دولية، مفصولة بفواصل)، مثل 213550000000
ADMIN_PHONE_NUMBERS=
